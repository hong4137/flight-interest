# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 .gitignore 에 있습니다.
# GitHub 에서는 Settings -> Secrets and variables -> Actions 에 같은 이름으로 등록합니다.

# @BotFather 에서 /newbot 으로 발급
TELEGRAM_BOT_TOKEN=

# 봇에게 메시지를 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 의 chat.id
TELEGRAM_CHAT_ID=

# 선택. 없으면 오픈조(입국/출국 도시가 다른 조합) 실가 확인만 건너뜁니다.
SERPAPI_KEY=
